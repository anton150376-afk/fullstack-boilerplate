# Контракт, не источник значений — секреты передаются через менеджер
# паролей (docs/guides/onboarding.md), не через этот файл и не в переписке.

NODE_ENV=development
PORT=3000

# Адреса веба и приложений, которым браузер разрешает обращаться к API (CORS),
# через запятую, без слэша в конце. Пусто — CORS выключен. Локально: веб на
# 3001, веб-экспорт мобильного на 3002 (docker-compose.yml).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# PostgreSQL (apps/server). Формат — обычный connection string.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# База для интеграционных тестов репозиториев (apps/server/test/db.integration-spec.ts):
# с применёнными миграциями (`pnpm --filter server db:deploy`). Тесты чистят таблицы
# tasks, notes и uploaded_files — не указывайте сюда рабочую базу. Пусто — набор
# пропущен (docs/guides/testing.md).
TEST_DATABASE_URL=

# Redis (apps/server) — health-проверка и очереди BullMQ.
REDIS_URL=redis://localhost:6379

# Хранилище файлов, S3-совместимое (Garage в docker-compose для разработки).
S3_ENDPOINT=http://localhost:3900
# Адрес хранилища для клиента (браузер, приложение), если он отличается от
# S3_ENDPOINT: нужен в Docker, где сервер видит Garage как http://garage:3900,
# а браузер — как http://localhost:3900. Пусто — используется S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=garage
S3_BUCKET=app-files
# Ключ для локального Garage из docker-compose: Garage создаёт его при старте
# из этих значений (GARAGE_DEFAULT_ACCESS_KEY / GARAGE_DEFAULT_SECRET_KEY).
# Формат: идентификатор от 8 знаков из букв, цифр и "-_.", секрет от 16
# печатных ASCII-знаков. Значения ниже — только для локальной разработки,
# в других окружениях задайте свои.
S3_ACCESS_KEY_ID=GKdevlocal00000000000001
S3_SECRET_ACCESS_KEY=dev-only-secret-change-me-0123456789abcdef
S3_FORCE_PATH_STYLE=true

# Уровень логирования pino: fatal|error|warn|info|debug|trace.
LOG_LEVEL=info

# Шов трассировки OpenTelemetry (ядро 2.x, без экспортёра) — по умолчанию
# выключен, см. docs/apps/server.md.
OTEL_ENABLED=false

# Приёмник багрепорта (Фаза 9, только dev/test — в проде модуля нет
# вовсе). file — по умолчанию, пишет markdown в .bugs/; github и api
# требуют свои переменные ниже.
BUG_REPORT_RECEIVER=file
BUG_REPORT_GITHUB_OWNER=
BUG_REPORT_GITHUB_REPO=
BUG_REPORT_GITHUB_TOKEN=

# apps/web (Фаза 6) — читается Vite (import.meta.env), не Nest; живёт в
# apps/web/.env, этот файл — только контракт имени и примера.
VITE_API_URL=http://localhost:3000

# Адрес API для серверного рендеринга apps/web (рантайм, читается только на
# сервере). В Docker — внутреннее имя сервиса; без него SSR ходит на
# VITE_API_URL. См. apps/web/src/lib/api-url.ts.
API_INTERNAL_URL=http://localhost:3000

# Плавающая кнопка «сообщить о проблеме» (Фаза 9) — выключена по
# умолчанию, значение "true" включает рендер (apps/web/src/routes/__root.tsx).
VITE_ENABLE_BUG_REPORTS=false

# Обычно не задаются — apps/web/vite.config.ts сам вычисляет через git
# rev-parse и npm_package_version при каждой сборке. Переопределение —
# только для CI без .git или детерминированных тестов.
VITE_GIT_SHA=
VITE_BUILD_VERSION=

# MODE — встроенная переменная Vite (development/production/test),
# выставляется самим Vite по режиму сборки; здесь только для check:env —
# её нельзя задать через .env.
MODE=development

# apps/mobile (Фаза 7) — вшивается в бандл Metro (babel-preset-expo,
# префикс EXPO_PUBLIC_ обязателен для попадания в клиентский код).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Плавающая кнопка «сообщить о проблеме» (Фаза 9) — выключена по
# умолчанию, значение "true" включает рендер.
EXPO_PUBLIC_ENABLE_BUG_REPORTS=false

# В отличие от apps/web, у Metro нет шага сборки, на котором можно
# вычислить git SHA/версию (нет аналога vite.config.ts define) — задаются
# вручную в CI (например, EXPO_PUBLIC_GIT_SHA=$(git rev-parse --short HEAD)
# перед expo start/export), по умолчанию "unknown"/"0.0.0".
EXPO_PUBLIC_GIT_SHA=
EXPO_PUBLIC_BUILD_VERSION=

# Сквозные тесты Playwright (apps/web/e2e) — нужны только при их запуске
# (docs/apps/web.md, раздел «Сквозные тесты»). Адреса запущенных API и веба;
# E2E_BROWSER_CHANNEL=msedge берёт установленный Edge вместо скачанного Chromium.
E2E_API_URL=http://localhost:3000
E2E_WEB_URL=http://localhost:3001
E2E_BROWSER_CHANNEL=
E2E_REUSE_SERVERS=
