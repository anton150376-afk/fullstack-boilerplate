{
  "name": "boilerplate",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts --cache --cache-location .eslintcache",
    "lint:fix": "turbo run lint -- --fix && eslint scripts --fix --cache --cache-location .eslintcache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mobile": "pnpm --filter mobile --filter @boilerplate/ui-native test",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:backlog": "tsx scripts/check-backlog.ts",
    "check:parity": "tsx scripts/check-parity.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:runtime": "tsx scripts/check-runtime.ts",
    "check:boundaries": "turbo boundaries",
    "gate": "bash scripts/done-gate.sh",
    "gate:full": "bash scripts/done-gate.sh --full",
    "gate:offline": "bash scripts/offline-gate.sh",
    "verify": "pnpm gate",
    "docker:up": "docker compose up -d",
    "docker:up:app": "docker compose --profile app up -d --build",
    "docker:up:web": "docker compose --profile web up -d --build",
    "docker:up:mobile-web": "docker compose --profile mobile-web up -d --build",
    "docker:down": "docker compose down",
    "compose:check": "bash scripts/compose-check.sh"
  },
  "devDependencies": {
    "@boilerplate/eslint-config": "workspace:*",
    "@boilerplate/prettier-config": "workspace:*",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "catalog:",
    "shadcn": "catalog:",
    "tsx": "catalog:",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
