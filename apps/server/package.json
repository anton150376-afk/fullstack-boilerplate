{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node --watch-path=src --import @swc-node/register/esm-register src/main.ts",
    "dev:worker": "node --watch-path=src --import @swc-node/register/esm-register src/queue/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --conditions=compiled dist/main.js",
    "start:worker": "node --conditions=compiled dist/queue/worker.js",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:test": "tsx prisma/seed-test.ts"
  },
  "dependencies": {
    "@boilerplate/contract": "workspace:*",
    "@boilerplate/devtools": "workspace:*",
    "@boilerplate/storage": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/terminus": "12.1.0",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/nest": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.5.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "file-type": "22.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@boilerplate/eslint-config": "workspace:*",
    "@boilerplate/testing": "workspace:*",
    "@boilerplate/typescript-config": "workspace:*",
    "@nestjs/testing": "12.3.2",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@tanstack/query-core": "catalog:",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
